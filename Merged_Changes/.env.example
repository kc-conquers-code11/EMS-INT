DB_NAME=ems
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306
TEST_DB_NAME=ems_test
PROD_DB_NAME=ems_prod
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=
CLIENT_URL=http://localhost:5173

# SMTP (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
# Optional display name; must match SMTP_USER for Gmail
SMTP_FROM=your.email@gmail.com

# BullMQ (hall ticket scheduled publish)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# DISABLE_HALL_TICKET_WORKER=true